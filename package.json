{
  "name": "slms-backend",
  "version": "0.1.0",
  "description": "SLMS backend - Express.js API, Swagger, MySQL, and raw SQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 --test-coverage-include=src/middlewares/*.js --test-coverage-include=src/utils/*.js --test-coverage-lines=100 --test-coverage-functions=100 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
