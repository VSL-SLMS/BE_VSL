NODE_ENV=development
PORT=5050
BACKEND_PUBLIC_URL=http://localhost:5050

# Local frontend or deployed Vercel URL. Comma-separated values are allowed.
CORS_ORIGINS=http://localhost:3000,https://fe-vsl.vercel.app
FRONTEND_URL=https://fe-vsl.vercel.app

# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Local MySQL variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vsl_learning

# Railway MySQL variables are also supported automatically:
# MYSQLHOST
# MYSQLPORT
# MYSQLUSER
# MYSQLPASSWORD
# MYSQLDATABASE
# MYSQL_URL, MYSQL_PRIVATE_URL, MYSQL_PUBLIC_URL, or DATABASE_URL
#
# Only enable this if your MySQL provider requires SSL.
DB_SSL=false
