NODE_ENV=development
PORT=5050

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vsl_learning

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=15000
SMTP_DRY_RUN=false
OTP_EXPIRES_MINUTES=10

# Cloudinary signed direct uploads for assignment submissions
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SUBMISSION_FOLDER=slms/submissions
CLOUDINARY_ALLOWED_FORMATS=mp4,mov,webm
CLOUDINARY_MAX_UPLOAD_BYTES=104857600
CLOUDINARY_MAX_VIDEO_DURATION_SECONDS=600
CLOUDINARY_UPLOAD_TYPE=authenticated

# Email delivery. Use "auto" to prefer Resend when RESEND_API_KEY is set, otherwise SMTP.
MAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM=SLMS <no-reply@mail.vsl.lat>

# VNPay Sandbox
COURSE_CODE=SIGN_LANGUAGE_101
COURSE_PRICE_VND=299000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result
VNPAY_IPN_URL=http://localhost:5050/api/payments/vnpay/ipn
